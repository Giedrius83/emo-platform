# Copy to .env on the server only. Never commit a filled-in copy.
NODE_ENV=production
PORT=3000
# Public HTTPS origin Twilio calls back to. No trailing slash.
PUBLIC_BASE_URL=https://voice.example.com

# Both flags default OFF. LIVE_DIAL=true is owner-only, after an explicit greenlight.
OUTREACH_CALL_CHANNEL=false
LIVE_DIAL=false
MAX_CONCURRENT_CALLS=2
CALLING_TZ=Europe/Oslo
CALLING_START=09:00
CALLING_END=18:00
# Enqueue requires plan_gate_ok=true in the body (fail-closed). Keep true.
REQUIRE_PLAN_GATE=true
MAX_CALL_ATTEMPTS=3

# Shared secret for POST /v1/calls/enqueue, /v1/calls/opt-out, GET /v1/calls/:id
# (sent as "Authorization: Bearer <secret>"). Generate: openssl rand -hex 32
ENQUEUE_AUTH_SECRET=change-me

TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=            # E.164, e.g. +47xxxxxxxx
# Optional Twilio answering-machine detection (costs extra; leaves a short voicemail once)
AMD_ENABLED=false

# Speech. STT and TTS run inside Twilio (<Gather input="speech"> / <Say>).
STT_LANGUAGE=nb-NO
TTS_LANGUAGE=nb-NO
TTS_VOICE=Polly.Liv

# Optional LLM for off-script replies: none | openai | anthropic
# With "none" the secretary stays on the Variant C script and hands hard questions to Giedrius.
LLM_PROVIDER=none
LLM_API_KEY=
LLM_MODEL=
# LLM_BASE_URL=            # only for openai-compatible gateways

# Where call records, audit log and transcripts are kept (journal + txt files)
DATA_DIR=./data
# How often the dial worker checks the queue (ms). It never dials while LIVE_DIAL=false.
WORKER_INTERVAL_MS=5000
