{
  "name": "voice-worker",
  "version": "0.1.0",
  "private": true,
  "description": "Standalone Norwegian (nb) outbound voice secretary on Twilio. Fail-closed; LIVE_DIAL off by default.",
  "type": "module",
  "engines": {
    "node": ">=22.6"
  },
  "scripts": {
    "start": "node --experimental-strip-types --no-warnings=ExperimentalWarning src/server.ts",
    "dev": "node --experimental-strip-types --no-warnings=ExperimentalWarning --watch src/server.ts",
    "test": "node --experimental-strip-types --no-warnings=ExperimentalWarning --test tests/*.test.ts",
    "typecheck": "tsc --noEmit",
    "smoke": "bash scripts/smoke.sh"
  },
  "dependencies": {},
  "devDependencies": {
    "@types/node": "^22.16.5",
    "typescript": "^5.9.0"
  }
}
